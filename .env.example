# Copy to .env (never commit real secrets)
PORT=3000
SESSION_SECRET=replace-with-32-byte-random-hex-in-production

# Optional: Supabase PostgreSQL connection for production multi-instance persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Single LLM Provider for draft copy polishing (Core platform works 100% deterministically without this)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
